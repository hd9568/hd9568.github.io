---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../lib/blog';

interface Props {
  src: ImageMetadata;
  pdf: string;
  alt: string;
  caption: string;
}
const { src, pdf, alt, caption } = Astro.props;
---
<figure class="paper-figure">
  <a href={withBase(pdf)} target="_blank" rel="noopener" aria-label={`${alt}：打开原始 PDF`}>
    <Image src={src} alt={alt} width={src.width} height={src.height} format="webp" quality={90} loading="lazy" />
  </a>
  <figcaption>{caption} <a href={withBase(pdf)} target="_blank" rel="noopener">查看原图 ↗</a></figcaption>
</figure>
<style>
  .paper-figure { margin: 28px 0; padding: 15px; border: 1px solid var(--line); border-radius: 5px; background: #fff; }
  .paper-figure :global(img) { width: 100%; height: auto; margin: 0 auto 12px; }
  figcaption { color: var(--muted); font-size: 12px; line-height: 1.8; }
  figcaption a { white-space: nowrap; }
  @media (max-width: 600px) { .paper-figure { padding: 8px; } }
</style>
