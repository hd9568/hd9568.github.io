---
import { SITE_GITHUB, SITE_NAME } from '../consts';
import { withBase } from '../lib/blog';
---
<footer class="container site-footer">
  <div class="footer-top">
    <span>© {new Date().getFullYear()} {SITE_NAME}<span class="footer-separator">·</span>理解原理，记录实践。</span>
    <div><a href={withBase('rss.xml')}>RSS ↗</a><a href={SITE_GITHUB} target="_blank" rel="noreferrer">GitHub ↗</a><a href="#main">回到顶部 ↑</a></div>
  </div>
  <p>个人学习笔记 · 内容包含 AI 辅助生成、人工整理与持续校订。</p>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 26px 28px; color: var(--muted); font-size: 11px; }
  .footer-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 15px; }
  .footer-top > div { display: flex; gap: 24px; }
  .footer-separator { margin: 0 12px; }
  p { font-size: 10px; margin: 8px 0 0; }
</style>
