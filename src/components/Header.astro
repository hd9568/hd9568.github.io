---
import { SITE_GITHUB } from '../consts';
import { withBase } from '../lib/blog';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const links = [
  { href: '', text: '首页', active: path === '/' },
  { href: 'blog/', text: '文章', active: path.startsWith('/blog') || path.startsWith('/topics') },
  { href: 'about/', text: '关于', active: path.startsWith('/about') },
];
---
<a class="skip-link" href="#main">跳到主要内容</a>
<header class="site-header">
  <nav class="container nav-shell" aria-label="主导航">
    <a class="brand" href={withBase()} aria-label="霍墨墨 AI Infra Notes 首页">
      <span class="brand-mark">h<span>.</span></span>
      <span class="brand-name">霍墨墨<span class="brand-divider">/</span><span class="brand-subtitle">INFRA NOTES</span></span>
    </a>
    <div class="nav-links">
      {links.map((link) => <a href={withBase(link.href)} aria-current={link.active ? 'page' : undefined}>{link.text}</a>)}
      <span class="nav-divider" aria-hidden="true"></span>
      <a class="github-link" href={SITE_GITHUB} target="_blank" rel="noreferrer" aria-label="GitHub（新窗口打开）">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 30; background: #faf9f6f2; backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .nav-shell { height: 76px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-mark { font-family: Georgia, serif; width: 34px; height: 34px; display: flex; justify-content: center; align-items: center; background: var(--ink); color: white; font-size: 28px; font-weight: bold; line-height: 1; border-radius: 5px; padding-bottom: 5px; }
  .brand-mark > span { color: #dc916a; }
  .brand-name { font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 16px; }
  .brand-divider { color: #c7c9c0; font-weight: 400; }
  .brand-subtitle { font: 10px var(--font-mono); letter-spacing: .12em; color: var(--muted); }
  .nav-links { display: flex; align-items: center; gap: 29px; font-size: 13px; }
  .nav-links a { display: inline-flex; align-items: center; min-height: 44px; gap: 8px; color: var(--muted); position: relative; }
  .nav-links a:hover, .nav-links a[aria-current] { color: var(--ink); }
  .nav-links a[aria-current]::after { content: ''; position: absolute; width: 4px; height: 4px; bottom: 0; left: calc(50% - 2px); background: var(--accent); border-radius: 50%; }
  .nav-divider { height: 15px; width: 1px; background: var(--line); }
  @media (max-width: 650px) { .brand-divider, .brand-subtitle, .nav-divider, .github-link { display: none !important; } .nav-shell { height: 65px; } .nav-links { gap: 22px; } }
  @media (max-width: 360px) { .brand-name { display: none; } }
</style>
