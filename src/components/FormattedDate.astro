---
interface Props {
	date: Date;
	format?: 'date' | 'datetime';
}

const { date, format = 'date' } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		format === 'datetime'
			? date.toLocaleString('zh-CN', {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
					hour: '2-digit',
					minute: '2-digit',
					hour12: false,
			  })
			: date.toLocaleDateString('zh-CN', {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
			  })
	}
</time>
