---
import type { CollectionEntry } from 'astro:content';
import { postUrl, readingMinutes } from '../lib/blog';
import FormattedDate from './FormattedDate.astro';
interface Props { post: CollectionEntry<'blog'>; showCategory?: boolean; compact?: boolean; }
const { post, showCategory = false, compact = false } = Astro.props;
---
<article class:list={['post-row', { compact }]}>
  <a class="post-row-link" href={postUrl(post.id)}>
    <div class="row-main">
      {showCategory && <span class="post-category">{post.data.category ?? '未分类'}</span>}
      <h3>{post.data.title}</h3>
      {!compact && <p>{post.data.description}</p>}
      <div class="row-meta"><FormattedDate date={post.data.pubDate} /><span>·</span><span>约 {readingMinutes(post.body)} 分钟</span></div>
    </div>
    <span class="row-arrow" aria-hidden="true">↗</span>
  </a>
</article>
<style>
  .post-row { border-bottom: 1px solid var(--line); }
  .post-row-link { display: flex; align-items: center; gap: 22px; padding: 25px 0; transition: color .2s; }
  .row-main { min-width: 0; flex: 1; }
  h3 { font-size: 16px; font-weight: 550; line-height: 1.65; transition: color .2s; }
  a:hover h3 { color: var(--accent); }
  p { font-size: 12px; color: var(--muted); margin: 8px 0 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.8; }
  .post-category { display: block; color: var(--accent); font-size: 10px; margin-bottom: 7px; }
  .row-meta { display: flex; align-items: center; gap: 9px; font-size: 10px; color: var(--muted); margin-top: 7px; font-family: var(--font-mono); }
  .row-arrow { font-size: 20px; color: #85897d; transition: transform .2s; }
  a:hover .row-arrow { transform: translate(2px, -2px); color: var(--accent); }
  .compact .post-row-link { padding: 17px 0; }
  .compact h3 { font-size: 14px; }
  @media (max-width: 480px) { h3 { font-size: 15px; } .post-row-link { gap: 14px; } }
</style>
