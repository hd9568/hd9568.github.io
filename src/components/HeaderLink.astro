---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const cleanedPath = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
const cleanedHref = typeof href === 'string' && href.endsWith('/') && href !== '/' ? href.slice(0, -1) : href;
const isActive = cleanedHref === cleanedPath;
---

<a href={href} class:list={[className, 'nav-link', { active: isActive }]} {...props}>
  <slot />
</a>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    color: rgb(var(--text-main));
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: rgb(var(--text-strong));
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-link.active {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
</style>
