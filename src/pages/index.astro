---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_GITHUB, SITE_NAME, SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPost = posts[0];
const restPosts = posts.slice(1, 4);
const topics = ['C++', 'CUDA', 'Inference', 'Training'];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero-wrap">
        <div class="container hero-shell">
          <div class="hero-copy">
            <p class="eyebrow">{SITE_NAME}</p>
            <h1>AI Infra / 训推优化学习笔记</h1>
            <p class="hero-subtitle">记录 C++、CUDA、推理优化与训练优化。</p>

            <div class="hero-actions">
              <a class="button primary" href="/blog">查看文章</a>
              <a class="button secondary" href={SITE_GITHUB} target="_blank" rel="noreferrer">GitHub</a>
            </div>

            <div class="hero-topics">
              {topics.map((topic) => <span class="kbd-like">{topic}</span>)}
            </div>
          </div>
        </div>
      </section>

      <section class="container content-grid">
        {latestPost && (
          <article class="latest-card light-card">
            <div class="latest-head">
              <p class="eyebrow">Latest</p>
              <p class="latest-date"><FormattedDate date={latestPost.data.pubDate} /></p>
            </div>
            <h2>{latestPost.data.title}</h2>
            <p class="latest-description">{latestPost.data.description}</p>
            <a class="button primary" href={`/blog/${latestPost.id}/`}>阅读全文</a>
          </article>
        )}

        <section class="archive-card light-card">
          <div class="archive-head">
            <p class="eyebrow">Archive</p>
            <a class="archive-link" href="/blog">全部文章</a>
          </div>

          <div class="archive-list">
            {(restPosts.length ? restPosts : posts.slice(0, 1)).map((post) => (
              <a class="archive-item" href={`/blog/${post.id}/`}>
                <span class="archive-title">{post.data.title}</span>
                <span class="archive-date"><FormattedDate date={post.data.pubDate} /></span>
              </a>
            ))}
          </div>
        </section>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .hero-wrap {
    padding: 1.4rem 0 1.3rem;
  }

  .hero-shell {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 78% 18%, rgba(var(--accent-soft), 0.24), transparent 18rem),
      linear-gradient(135deg, rgb(var(--bg)), rgb(var(--bg-soft)));
    box-shadow: var(--card-shadow);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    min-width: 0;
    max-width: 720px;
    padding: clamp(2rem, 7vw, 5rem);
    animation: fade-up 0.5s ease both;
  }

  .hero-shell::after {
    content: '';
    position: absolute;
    inset: auto -12% -36% 42%;
    height: 70%;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgba(var(--accent), 0.2), transparent);
    filter: blur(24px);
    transform: rotate(-8deg);
  }

  .hero-copy h1 {
    color: rgb(245, 247, 250);
  }

  .hero-subtitle {
    max-width: 32rem;
    font-size: 1.08rem;
    color: rgb(209, 215, 224);
  }

  .hero-actions,
  .hero-topics {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .hero-actions {
    margin-top: 1.5rem;
  }

  .hero-topics {
    margin-top: 1rem;
  }

  .hero-shell .button.secondary,
  .hero-shell .kbd-like {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.12);
    color: rgb(245, 247, 250);
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.2rem;
    padding: 1.2rem 0 2.5rem;
  }

  .latest-card,
  .archive-card {
    padding: 1.4rem;
  }

  .latest-head,
  .archive-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .latest-card h2,
  .archive-title {
    color: rgb(var(--text-dark));
  }

  .latest-date,
  .latest-description,
  .archive-date {
    color: rgb(var(--text-dark-muted));
  }

  .archive-head {
    margin-bottom: 1rem;
  }

  .archive-link {
    color: rgb(var(--text-dark));
    text-decoration: none;
    font-weight: 700;
  }

  .archive-list {
    display: grid;
    gap: 0.75rem;
  }

  .archive-item {
    display: grid;
    gap: 0.25rem;
    padding: 0.95rem 1rem;
    border-radius: 1rem;
    background: rgb(var(--surface-muted));
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .archive-item:hover {
    transform: translateX(4px);
    background: rgba(var(--accent-soft), 0.08);
  }

  .archive-date {
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .hero-wrap {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .hero-copy {
      padding: 1.4rem;
    }

    .hero-actions .button {
      width: 100%;
    }

    .latest-card,
    .archive-card {
      padding: 1rem;
    }

    .latest-head,
    .archive-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
