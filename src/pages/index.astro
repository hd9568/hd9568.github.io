---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostRow from '../components/PostRow.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getBlog, categoryUrl, withBase, PREVIEW_SIZE } from '../lib/blog';
const { posts, groups } = await getBlog();
const layers = [
  { index: '03', title: '模型与分布式系统', subtitle: 'INFERENCE · TRAINING', slugs: ['inference', 'training', 'research'] },
  { index: '02', title: 'GPU 与高性能计算', subtitle: 'CUDA · KERNEL OPTIMIZATION', slugs: ['cuda'] },
  { index: '01', title: '语言与系统基础', subtitle: 'C++ · ALGORITHMS · OS', slugs: ['cpp', 'algorithms', 'systems'] },
];
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main id="main" class="container">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span>A PERSONAL KNOWLEDGE BASE</p>
          <h1>向下理解原理，<br />向上构建<span>系统。</span></h1>
          <p class="hero-description">一个关于 AI Infrastructure 的学习笔记本。<br />记录 C++、GPU 编程与训推优化，连接论文、源码和实践。</p>
          <div class="hero-actions"><a class="button primary" href={withBase('blog/')}>开始阅读 <span aria-hidden="true">↗</span></a><a class="text-link" href="#topics">探索知识分类 <span aria-hidden="true">↓</span></a></div>
          <div class="hero-stats"><span><strong>{posts.length}</strong> 篇学习笔记</span><i></i><span><strong>{groups.length}</strong> 个知识分类</span><i></i><span>持续积累中 <span class="status-dot"></span></span></div>
        </div>
        <div class="knowledge-map" aria-label="从语言基础到模型系统的知识层次">
          <div class="map-head"><span class="eyebrow">THE INFRA STACK</span><span class="map-cross" aria-hidden="true">+</span></div>
          {layers.map((layer) => (
            <div class="stack-layer">
              <span class="layer-number">{layer.index}</span>
              <div class="layer-copy"><h2>{layer.title}</h2><p>{layer.subtitle}</p><div class="layer-links">{layer.slugs.map((slug) => { const group = groups.find((g) => g.slug === slug); return group && <a href={categoryUrl(slug)}>{group.name}<span aria-hidden="true">↗</span></a>; })}</div></div>
              <span class="layer-line" aria-hidden="true"></span>
            </div>
          ))}
          <div class="map-foot"><span>BUILD FROM FIRST PRINCIPLES</span><span aria-hidden="true">↑</span></div>
        </div>
      </section>

      <section class="topics-section" id="topics">
        <div class="section-heading"><h2>知识分类 <small>KNOWLEDGE INDEX</small></h2><a class="text-link" href={withBase('blog/')}>浏览全部 <span aria-hidden="true">↗</span></a></div>
        <div class="topic-grid">
          {groups.map((group, index) => <a class="topic-card" href={categoryUrl(group.slug)}><div class="topic-top"><span class="topic-symbol" aria-hidden="true">{group.symbol}</span><span>{String(index + 1).padStart(2, '0')}</span></div><h3>{group.name}</h3><p>{group.description}</p><div class="topic-bottom"><span>{group.posts.length} 篇笔记</span><span aria-hidden="true">↗</span></div></a>)}
          <a class="topic-card index-card" href={withBase('blog/')}><span class="eyebrow">KEEP EXPLORING</span><h3>每一次理解，<br />都有迹可循。</h3><div class="topic-bottom"><span>打开文章索引</span><span aria-hidden="true">↗</span></div></a>
        </div>
      </section>

      <section class="recent-section">
        <div class="recent-main">
          <div class="section-heading"><h2>最近更新 <small>RECENT NOTES</small></h2><span class="eyebrow">LATEST {Math.min(PREVIEW_SIZE, posts.length)}</span></div>
          <div class="recent-posts">{posts.slice(0, PREVIEW_SIZE).map((post) => <PostRow post={post} showCategory />)}</div>
          <a class="text-link all-notes" href={withBase('blog/')}>查看全部 {posts.length} 篇笔记 <span aria-hidden="true">→</span></a>
        </div>
        <aside class="reading-note"><span class="eyebrow">A NOTE ON LEARNING</span><span class="note-decoration" aria-hidden="true">“</span><h2>不止于知道，<br />更在于理解。</h2><p>从一个问题出发，读一篇论文，拆一段源码，再把理解整理成笔记。</p><p>这里记录这条路上的思考，也留下一份可以反复查阅的知识索引。</p><a class="text-link" href={withBase('about/')}>关于这个笔记本 <span aria-hidden="true">↗</span></a><div class="note-bottom"><span>霍墨墨</span><span class="eyebrow">LEARN · BUILD · REPEAT</span></div></aside>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .hero { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 70px; padding: 68px 0 61px; }
  .hero-copy > .eyebrow { margin-bottom: 24px; font-size: 10px; display: flex; align-items: center; gap: 9px; }
  .status-dot { width: 5px; height: 5px; display: inline-block; background: #738168; border-radius: 50%; }
  h1 { font-size: clamp(32px, 3.6vw, 48px); line-height: 1.5; letter-spacing: -.035em; font-weight: 600; }
  h1 > span { color: var(--accent); }
  .hero-description { color: var(--muted); font-size: 13px; line-height: 2; margin: 20px 0 26px; }
  .hero-actions { display: flex; align-items: center; gap: 25px; }
  .hero-stats { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; margin-top: 34px; color: var(--muted); font-size: 10px; }
  .hero-stats strong { color: var(--ink); font: 16px var(--font-mono); margin-right: 4px; }
  .hero-stats i { width: 1px; height: 12px; background: var(--line); }
  .hero-stats .status-dot { margin-left: 6px; }
  .knowledge-map { border: 1px solid #dfe2d7; border-radius: 7px; background: #f0f1eb; padding: 21px 24px 15px; position: relative; }
  .map-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 17px; }
  .map-head .eyebrow { font-size: 9px; }
  .map-cross { font: 19px var(--font-mono); color: #93988a; }
  .stack-layer { display: flex; align-items: flex-start; position: relative; gap: 15px; background: #fafbf7; border: 1px solid #dce0d3; padding: 18px 17px 15px; margin-bottom: 10px; border-radius: 3px; }
  .stack-layer:nth-of-type(3) { margin-inline: 9px; }
  .stack-layer:nth-of-type(4) { margin-inline: 18px; }
  .layer-number { color: #969c8c; font: 10px var(--font-mono); padding-top: 4px; }
  .layer-copy { flex: 1; }
  .layer-copy h2 { font-size: 14px; font-weight: 550; }
  .layer-copy p { font: 8px var(--font-mono); letter-spacing: .09em; color: #818775; margin: 7px 0 11px; }
  .layer-links { display: flex; flex-wrap: wrap; gap: 6px; }
  .layer-links a { font-size: 9px; color: #727b67; border: 1px solid #e4e7dc; border-radius: 2px; padding: 1px 6px; }
  .layer-links a:hover { color: var(--accent); border-color: var(--accent); }
  .layer-links a span { margin-left: 7px; }
  .layer-line { width: 17px; height: 2px; margin-top: 7px; background: #b3bca4; }
  .stack-layer:nth-of-type(2) .layer-line { background: var(--accent); }
  .map-foot { display: flex; align-items: center; justify-content: space-between; font: 8px var(--font-mono); letter-spacing: .07em; color: #828a75; margin-top: 17px; }
  .topics-section { padding: 31px 0 45px; border-top: 1px solid var(--line); }
  .topic-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .topic-card { display: flex; flex-direction: column; background: #fdfcf9; border: 1px solid var(--line); border-radius: 5px; padding: 20px; transition: border-color .2s, background .2s; }
  .topic-card:hover { background: white; border-color: #b4baa9; }
  .topic-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .topic-top > span:last-child { font: 9px var(--font-mono); color: #979c90; }
  .topic-symbol { font: 18px var(--font-mono); color: #78826b; }
  .topic-card h3 { font-size: 14px; margin-bottom: 8px; }
  .topic-card p { font-size: 11px; color: var(--muted); line-height: 1.9; margin-bottom: 23px; }
  .topic-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: auto; font-size: 10px; color: var(--muted); }
  .topic-bottom > span:last-child { font-size: 17px; }
  .index-card { background: var(--soft); border-color: #dfe2d7; }
  .index-card .eyebrow { font-size: 9px; }
  .index-card h3 { margin-top: 20px; font-size: 20px; line-height: 1.65; }
  .recent-section { display: grid; grid-template-columns: minmax(0, 1fr) 285px; gap: 60px; padding: 18px 0 70px; }
  .recent-main > .section-heading { padding-bottom: 18px; border-bottom: 1px solid var(--line); margin-bottom: 0; }
  .reading-note { align-self: start; background: #f0f1eb; border: 1px solid #e2e5db; border-radius: 5px; padding: 27px; margin-top: 0; }
  .reading-note > .eyebrow { font-size: 9px; }
  .note-decoration { display: block; font: 65px Georgia, serif; color: #a9b19b; height: 65px; margin-top: 27px; }
  .reading-note h2 { font-size: 24px; line-height: 1.6; margin-bottom: 22px; }
  .reading-note p { color: #747c69; font-size: 12px; line-height: 2; }
  .reading-note .text-link { font-size: 11px; margin-top: 12px; }
  .note-bottom { border-top: 1px solid #dbe0d2; padding-top: 19px; margin-top: 28px; display: grid; gap: 6px; font-size: 12px; }
  .note-bottom .eyebrow { font-size: 8px; }
  .all-notes { margin-top: 22px; }
  @media (max-width: 1000px) { .hero { gap: 35px; } .recent-section { gap: 35px; } .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .hero { grid-template-columns: 1fr; padding: 38px 0; gap: 36px; } h1 { font-size: 36px; } .knowledge-map { max-width: 100%; } .recent-section { grid-template-columns: 1fr; gap: 36px; } .reading-note { display: none; } .hero-stats { gap: 12px; } }
  @media (max-width: 380px) { .topic-card { padding: 15px; } .hero-actions { gap: 20px; } }
</style>
