---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import PostRow from '../../components/PostRow.astro';
import Search from '../../components/Search.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getBlog, categoryUrl, PREVIEW_SIZE } from '../../lib/blog';
const { posts, groups } = await getBlog();
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={`文章索引 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main id="main" class="container">
      <header class="page-heading"><p class="eyebrow accent">THE NOTEBOOK / 文章索引</p><h1>让知识，有序生长。</h1><p>{posts.length} 篇学习笔记，{groups.length} 个知识分类。从一个感兴趣的问题开始。</p></header>
      <div class="archive-layout">
        <CategoryNav groups={groups} />
        <div class="archive-content">
          <Search posts={posts} groups={groups} />
          <div id="category-overview">
            <div class="overview-note"><span>按分类浏览</span><span>每类展示最新 {PREVIEW_SIZE} 篇</span></div>
            {groups.map((group) => <section class="category-section" id={group.name} data-category={group.slug}>
              <div class="section-heading"><h2>{group.name}<span class="category-count">{group.posts.length}</span></h2><a class="text-link" href={categoryUrl(group.slug)}>查看全部 <span aria-hidden="true">↗</span></a></div>
              <div>{group.posts.slice(0, PREVIEW_SIZE).map((post) => <PostRow post={post} compact />)}</div>
              {group.posts.length > PREVIEW_SIZE && <a class="category-more" href={categoryUrl(group.slug)}>还有 {group.posts.length - PREVIEW_SIZE} 篇笔记，进入分类阅读 <span aria-hidden="true">→</span></a>}
            </section>)}
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .overview-note { display: flex; justify-content: space-between; margin: 26px 0; font-size: 11px; color: var(--muted); }
</style>
