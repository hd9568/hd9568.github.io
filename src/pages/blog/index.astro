---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featuredPost, ...restPosts] = posts;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="blog-page container">
      <section class="page-head">
        <p class="eyebrow">Blog Archive</p>
        <h1>学习文章</h1>
        <p>
          这里按主题整理 AI Infra、训练与推理优化相关内容。每篇都会尽量回答清楚“这是什么、为什么重要、容易踩什么坑、怎么在面试里讲清楚”。
        </p>
      </section>

      {featuredPost && (
        <section class="featured light-card">
          <div>
            <p class="feature-label">Featured</p>
            <h2><a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
            <p class="feature-description">{featuredPost.data.description}</p>
            <div class="feature-meta">
              <FormattedDate date={featuredPost.data.pubDate} />
              <span>·</span>
              <span>基础专题</span>
            </div>
          </div>
          <a class="button primary" href={`/blog/${featuredPost.id}/`}>阅读文章</a>
        </section>
      )}

      <section class="post-grid">
        {restPosts.map((post) => (
          <article class="post-card light-card">
            <p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <a class="read-more" href={`/blog/${post.id}/`}>阅读全文</a>
          </article>
        ))}

        {!restPosts.length && featuredPost && (
          <article class="empty-card light-card">
            <p class="feature-label">Next</p>
            <h3>后续会继续补齐 `infra_list.md` 中的高频知识点。</h3>
            <p>下一批文章会继续围绕 C++、CUDA、LLM 推理优化和分布式训练展开。</p>
          </article>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-page {
    padding: 2rem 0 3rem;
  }

  .page-head {
    max-width: 44rem;
    margin-bottom: 1.5rem;
  }

  .featured {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 1.5rem;
  }

  .feature-label,
  .post-date,
  .read-more {
    color: rgb(var(--accent));
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.84rem;
  }

  .featured h2,
  .post-card h3,
  .empty-card h3 {
    color: rgb(var(--text-dark));
  }

  .featured h2 a,
  .post-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .feature-description,
  .feature-meta,
  .post-card p,
  .empty-card p {
    color: rgb(var(--text-dark-muted));
  }

  .feature-meta {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .post-card,
  .empty-card {
    padding: 1.35rem;
  }

  .post-card h3 {
    margin-top: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .read-more {
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .featured {
      flex-direction: column;
      align-items: flex-start;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .blog-page {
      padding-top: 1rem;
    }

    .featured,
    .post-card,
    .empty-card {
      padding: 1.2rem;
    }
  }
</style>
