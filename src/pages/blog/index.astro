---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categoryOrder = ['C++', '操作系统与多线程', 'CUDA'];
const fallbackCategory = '未分类';
const groupedPosts = categoryOrder
  .map((category) => ({
    category,
    posts: posts.filter((post) => (post.data.category ?? fallbackCategory) === category),
  }))
  .filter((group) => group.posts.length > 0);
const uncategorizedPosts = posts.filter((post) => !categoryOrder.includes(post.data.category ?? fallbackCategory));
if (uncategorizedPosts.length > 0) {
  groupedPosts.push({ category: fallbackCategory, posts: uncategorizedPosts });
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="blog-page container">
      <section class="page-head">
        <p class="eyebrow">Blog Archive</p>
        <h1>学习文章</h1>
        <p>
          按主题整理文章，方便后续扩展 CUDA、推理优化、分布式训练、模型量化等专题。
        </p>
      </section>

      <section class="category-nav" aria-label="文章分类">
        {groupedPosts.map((group) => (
          <a class="category-card light-card" href={`#${group.category}`}>
            <span>{group.category}</span>
            <strong>{group.posts.length}</strong>
          </a>
        ))}
      </section>

      {groupedPosts.map((group) => (
        <section class="category-section" id={group.category}>
          <div class="category-head">
            <div>
              <p class="feature-label">Category</p>
              <h2>{group.category}</h2>
            </div>
            <span>{group.posts.length} 篇</span>
          </div>

          <div class="post-grid">
            {group.posts.map((post) => (
              <article class="post-card light-card">
                <div class="post-card-top">
                  <p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
                  <span>{post.data.category ?? fallbackCategory}</span>
                </div>
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <a class="read-more" href={`/blog/${post.id}/`}>阅读全文</a>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-page {
    padding: 2rem 0 3rem;
  }

  .page-head {
    max-width: 44rem;
    margin-bottom: 1.5rem;
  }

  .category-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1.6rem;
  }

  .category-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    color: rgb(var(--text-dark));
    text-decoration: none;
  }

  .category-card span {
    font-weight: 800;
  }

  .category-card strong {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    background: rgba(var(--accent-soft), 0.12);
    color: rgb(var(--accent));
  }

  .feature-label,
  .post-date,
  .read-more {
    color: rgb(var(--accent));
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.84rem;
  }

  .category-section {
    scroll-margin-top: 5.5rem;
    margin-top: 1.8rem;
  }

  .category-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .category-head h2 {
    margin: 0.2rem 0 0;
    color: rgb(var(--text-dark));
  }

  .category-head span {
    color: rgb(var(--text-dark-muted));
    font-weight: 700;
  }

  .post-card h3 {
    color: rgb(var(--text-dark));
  }

  .post-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .post-card p {
    color: rgb(var(--text-dark-muted));
  }

  .post-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .post-card-top span {
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.06);
    color: rgb(var(--text-dark-muted));
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.18rem 0.6rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .post-card {
    padding: 1.35rem;
  }

  .post-card h3 {
    margin-top: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .read-more {
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .category-nav,
    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .blog-page {
      padding-top: 1rem;
    }

    .category-card,
    .post-card {
      padding: 1.2rem;
    }
  }
</style>
