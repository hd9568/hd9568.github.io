---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_EMAIL, SITE_GITHUB, SITE_NAME, SITE_TITLE } from '../consts';
import { getBlog, withBase } from '../lib/blog';
const { posts, groups } = await getBlog();
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={`关于 | ${SITE_TITLE}`} description={`${SITE_NAME}的 AI Infra 学习笔记：从基础知识到源码与系统实践。`} /></head>
  <body>
    <Header />
    <main id="main" class="container about-page">
      <div class="about-title"><p class="eyebrow accent">ABOUT THE NOTEBOOK</p><h1>你好，我是{SITE_NAME}。</h1><p>在 AI Infra 的世界里，保持好奇，持续学习。</p></div>
      <div class="about-grid">
        <section class="about-copy"><h2>一份持续生长的学习笔记</h2><p>这个博客用来整理 AI 基础设施方向的自学内容。从 C++、数据结构和操作系统，到 CUDA 算子、推理框架与分布式训练，把分散的知识连接起来。</p><p>内容包括基础原理、论文精读、源码分析和工程实践。每一篇笔记都是一个理解问题的过程，也是一份留给未来的参考。</p><h2>如何阅读</h2><p>按分类选择一个方向，从感兴趣的主题开始。分类页面按发布时间排序，文章底部可以继续阅读同类笔记；长文也可以通过目录直接定位章节。</p><a class="button primary" href={withBase('blog/')}>打开文章索引 <span aria-hidden="true">↗</span></a></section>
        <aside class="about-card"><div class="monogram" aria-hidden="true">h.</div><h2>{SITE_NAME}</h2><p class="eyebrow">AI INFRA / NOTES & PRACTICE</p><div class="about-stats"><span><strong>{posts.length}</strong>学习笔记</span><span><strong>{groups.length}</strong>知识分类</span></div><div class="about-links"><a href={SITE_GITHUB} target="_blank" rel="noreferrer">GitHub <span>↗</span></a><a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL} <span>↗</span></a><a href={withBase('rss.xml')}>订阅 RSS <span>↗</span></a></div></aside>
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .about-page { padding-block: 65px 90px; }
  .about-title { border-bottom: 1px solid var(--line); padding-bottom: 35px; margin-bottom: 40px; }
  .about-title h1 { font-size: clamp(26px, 4vw, 40px); margin: 16px 0; }
  .about-title > p:last-child { font-size: 14px; color: var(--muted); margin: 0; }
  .about-grid { display: grid; grid-template-columns: minmax(0, 630px) 300px; gap: 90px; }
  .about-copy h2 { font-size: 21px; margin: 5px 0 20px; }
  .about-copy h2:not(:first-child) { margin-top: 40px; }
  .about-copy p { font-size: 14px; color: var(--muted); line-height: 2.1; margin-bottom: 18px; }
  .about-copy .button { margin-top: 16px; }
  .about-card { padding: 30px; background: var(--soft); border: 1px solid var(--line); border-radius: 5px; align-self: start; }
  .monogram { font: bold 45px Georgia, serif; color: var(--accent); margin-bottom: 20px; }
  .about-card h2 { font-size: 20px; margin-bottom: 8px; }
  .about-card .eyebrow { font-size: 8px; }
  .about-stats { display: flex; gap: 50px; padding: 25px 0; border-bottom: 1px solid #dce0d4; }
  .about-stats > span { display: grid; font-size: 10px; color: var(--muted); gap: 4px; }
  .about-stats strong { font: 25px var(--font-mono); color: var(--ink); }
  .about-links { display: grid; padding-top: 20px; gap: 14px; }
  .about-links a { display: flex; justify-content: space-between; font-size: 12px; overflow-wrap: anywhere; }
  @media (max-width: 850px) { .about-grid { grid-template-columns: 1fr; gap: 40px; } .about-page { padding-top: 38px; } }
</style>
