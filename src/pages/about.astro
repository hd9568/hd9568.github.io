---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_EMAIL, SITE_GITHUB, SITE_NAME, SITE_TITLE } from '../consts';
import avatar from '../assets/avatar.png';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`关于 | ${SITE_TITLE}`} description={`${SITE_NAME} 的基本信息与联系入口。`} />
  </head>
  <body>
    <Header />
    <main class="about-page container">
      <section class="about-card light-card">
        <div class="about-avatar">
          <Image src={avatar} alt="霍墨墨头像" width={640} height={640} />
        </div>

        <div class="about-copy">
          <p class="eyebrow">About</p>
          <h1>{SITE_NAME}</h1>
          <p class="about-subtitle">AI Infra / 训推优化</p>

          <div class="about-links">
            <a class="button primary" href={SITE_GITHUB} target="_blank" rel="noreferrer">GitHub</a>
            <a class="button secondary" href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .about-page {
    padding: 2rem 0 3rem;
  }

  .about-card {
    display: grid;
    grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
    gap: 1.4rem;
    align-items: center;
    padding: 1.35rem;
  }

  .about-avatar {
    overflow: hidden;
    border-radius: calc(var(--radius-xl) - 8px);
    aspect-ratio: 1 / 1;
    background: rgb(var(--surface-muted));
  }

  .about-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-copy {
    min-width: 0;
  }

  .about-copy h1 {
    color: rgb(var(--text-dark));
    font-size: clamp(2.4rem, 6vw, 4rem);
  }

  .about-subtitle {
    margin-bottom: 1.2rem;
    color: rgb(var(--text-dark-muted));
    font-size: 1.05rem;
  }

  .about-links {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .about-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .about-page {
      padding-top: 1rem;
    }

    .about-card {
      padding: 1rem;
    }

    .about-links .button {
      width: 100%;
    }
  }
</style>
