---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type AdjacentPost = Pick<CollectionEntry<'blog'>, 'id' | 'data'>;
type Props = CollectionEntry<'blog'>['data'] & {
  previousPost?: AdjacentPost;
  nextPost?: AdjacentPost;
};

const { title, description, pubDate, updatedDate, heroImage, category = '未分类', previousPost, nextPost } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main class="post-layout container">
      <article class="post-shell light-card">
        <div class="post-header">
          <div class="meta-row">
            <span class="post-chip"><FormattedDate date={pubDate} /></span>
            <span class="post-chip">{category}</span>
            {updatedDate && <span class="post-chip">更新于 <FormattedDate date={updatedDate} /></span>}
          </div>
          <h1>{title}</h1>
          <p class="post-description">{description}</p>
        </div>

        {heroImage && (
          <div class="hero-image">
            <Image width={1200} height={630} src={heroImage} alt="" />
          </div>
        )}

        <div class="prose">
          <slot />
        </div>

        {(previousPost || nextPost) && (
          <nav class="post-nav" aria-label="文章导航">
            {previousPost ? (
              <a class="post-nav-card previous" href={`/blog/${previousPost.id}/`}>
                <span>上一篇</span>
                <strong>{previousPost.data.title}</strong>
              </a>
            ) : (
              <div class="post-nav-spacer" />
            )}

            {nextPost ? (
              <a class="post-nav-card next" href={`/blog/${nextPost.id}/`}>
                <span>下一篇</span>
                <strong>{nextPost.data.title}</strong>
              </a>
            ) : (
              <div class="post-nav-spacer" />
            )}
          </nav>
        )}
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .post-layout {
    padding: 2rem 0 3rem;
  }

  .post-shell {
    padding: 1.8rem;
  }

  .post-header {
    max-width: 48rem;
    margin-bottom: 1.4rem;
  }

  .meta-row {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .post-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.1);
    color: rgb(var(--accent));
    font-size: 0.9rem;
    font-weight: 700;
  }

  .post-shell h1 {
    color: rgb(var(--text-dark));
    font-size: clamp(2.4rem, 5vw, 4rem);
  }

  .post-description {
    color: rgb(var(--text-dark-muted));
    font-size: 1.08rem;
  }

  .hero-image {
    margin-bottom: 1.8rem;
    overflow: hidden;
    border-radius: 1.35rem;
  }

  .hero-image img {
    width: 100%;
  }

  .prose {
    max-width: 48rem;
    color: rgb(var(--text-dark));
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: rgb(var(--text-dark));
    margin-top: 2rem;
  }

  .prose :global(p),
  .prose :global(li),
  .prose :global(blockquote) {
    color: rgb(var(--text-dark-muted));
  }

  .prose :global(blockquote) p {
    color: rgb(var(--text-dark));
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.35rem;
  }

  .prose :global(a) {
    color: rgb(var(--accent));
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
  }

  .post-nav-card {
    min-width: 0;
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 1.2rem;
    background: rgb(var(--surface-muted));
    color: rgb(var(--text-dark));
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .post-nav-card:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--accent-soft), 0.24);
    background: rgba(var(--accent-soft), 0.08);
  }

  .post-nav-card span {
    color: rgb(var(--accent));
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .post-nav-card strong {
    overflow-wrap: anywhere;
    line-height: 1.45;
  }

  .post-nav-card.next {
    text-align: right;
  }

  @media (max-width: 720px) {
    .post-layout {
      padding-top: 1rem;
    }

    .post-shell {
      padding: 1.2rem;
    }

    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-spacer {
      display: none;
    }

    .post-nav-card.next {
      text-align: left;
    }
  }
</style>
